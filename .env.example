# Backend runtime
API_BIND_ADDRESS=127.0.0.1:3000
RUST_LOG=info
OTEL_SERVICE_NAME=market-bot-api

# Local data plane used by infra/compose/docker-compose.dev.yml
# These values are sandbox defaults, not production credentials.
DATABASE_URL=postgres://marketbot:marketbot_dev@127.0.0.1:5432/marketbot
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=market-bot-dev
S3_ACCESS_KEY=marketbot
S3_SECRET_KEY=marketbot_dev
S3_REGION=us-east-1

# Search (optional; OpenSearch is commented out of the default compose stack)
# OPENSEARCH_URL=http://127.0.0.1:9200

# Sandbox integrations only — do not point these at production providers
PAYMENT_PROVIDER=sandbox
LOGISTICS_PROVIDER=sandbox

# OpenTelemetry exporter (unset keeps logs only)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
